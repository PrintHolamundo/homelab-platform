# Proxmox API Connection
proxmox_endpoint    = "https://192.168.1.100:8006/"
proxmox_username    = "root@pam"
proxmox_password    = "your-password-here"
target_node         = "pve"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Container Specs
container_id          = 100
container_hostname    = "debian-srv"
container_description = "LXC container managed by Terraform"
unprivileged          = false

# OS Template
template_file_id = "local:vztmpl/debian-12-standard_12.2-1_amd64.tar.zst"

# Network
ipv4_address = "192.168.1.50/24"
ipv4_gateway = "192.168.1.1"

# Compute & Storage Resources
cpu_cores         = 2
memory_dedicated  = 2048
memory_swap       = 512
disk_datastore_id = "local"
disk_size         = 20

# Mount Points (Host -> Container)
mount_points = [
  {
    volume    = "/mnt/data-share"
    path      = "/mnt/data-share"
    read_only = false
  }
]