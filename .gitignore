.terraform/

# Dependency lock file
.terraform.lock.hcl

# Variable files containing credentials and secrets
*.tfvars
*.tfvars.json
terraform.tfvars

# Exported execution plans
tfplan
*.tfplan

# Crash log files
crash.log
crash.*.log

