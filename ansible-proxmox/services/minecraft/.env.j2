# User and Group IDs
PUID={{ PUID }}
PGID={{ PGID }}

# Timezone
TZ={{ TZ }}

# Storage Paths
MINECRAFT_STORAGE_PATH={{ CONFIG_DIR }}/minecraft

# Minecraft Server Settings
MINECRAFT_IMAGE={{ minecraft_image | default('itzg/minecraft-server:java25') }}
MINECRAFT_SERVER_PORT={{ minecraft_port | default('25565') }}
MINECRAFT_EULA={{ minecraft_eula | default('TRUE') }}
MINECRAFT_VERSION={{ minecraft_version | default('26.2') }}
MINECRAFT_TYPE={{ minecraft_type | default('FABRIC') }}
MINECRAFT_ONLINE_MODE={{ minecraft_online_mode | default('FALSE') }}
MINECRAFT_INIT_MEMORY={{ minecraft_init_memory | default('4G') }}
MINECRAFT_MAX_MEMORY={{ minecraft_max_memory | default('8G') }}
MINECRAFT_MOTD={{ minecraft_motd | default("             §b🌍 §cD§6e§ab§bi§9a§5n§f's §aServer §b🌍") }}
MINECRAFT_ICON={{ minecraft_icon | default('/data/server-icon.png') }}
MINECRAFT_FORCE_WORLD_UPGRADE={{ minecraft_force_world_upgrade | default('TRUE') }}
MINECRAFT_EXTRA_ARGS={{ minecraft_extra_args | default('--safeMode') }}

# Playit Tunnel Settings
PLAYIT_IMAGE={{ playit_image | default('ghcr.io/playit-cloud/playit-agent:1.0') }}
PLAYIT_SECRET_KEY={{ playit_secret_key }}
