# Paperless-ngx Environment Configuration
PAPERLESS_VERSION={{ paperless_version }}
USERMAP_UID={{ PUID }}
USERMAP_GID={{ PGID }}
PAPERLESS_TIME_ZONE={{ TZ }}
PAPERLESS_OCR_LANGUAGE={{ paperless_ocr_lang }}

# Storage paths
PAPERLESS_STORAGE_PATH={{ CONFIG_DIR }}/paperless

# Security and Reverse Proxy (Caddy / Cloudflare)
PAPERLESS_SECRET_KEY={{ paperless_secret_key }}
PAPERLESS_URL=https://paperless.{{ base_domain }}
PAPERLESS_USE_X_FORWARD_PORT=true
PAPERLESS_USE_X_FORWARD_HOST=true

# PostgreSQL Database
DB_NAME={{ paperless_db_name }}
DB_USER={{ paperless_db_user }}
DB_PASS={{ paperless_db_password }}

# Optional direct port
PAPERLESS_PORT={{ paperless_port | default('8000') }}
